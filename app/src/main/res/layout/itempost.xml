<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/postHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/pAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/kn_circle"
            android:backgroundTint="@color/kn_purple"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/kn_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/kn_text2"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="•••"
            android:textColor="@color/kn_text2" />

        <TextView
            android:id="@+id/pHide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="✕"
            android:textColor="@color/kn_text2"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/pText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingBottom="8dp"
        android:textColor="@color/kn_text"
        android:textSize="15sp" />

    <!-- Image grid (children built in PostAdapter) -->
    <LinearLayout
        android:id="@+id/pGrid"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:orientation="horizontal" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <TextView
            android:id="@+id/pReactions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/kn_text2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/pComments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:textColor="@color/kn_text2"
            android:textSize="13sp" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="10dp"
        android:background="@color/kn_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">

        <TextView
            android:id="@+id/pLike"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Like"
            android:textColor="@color/kn_text2"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pComment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Comment"
            android:textColor="@color/kn_text2"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pShare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Share"
            android:textColor="@color/kn_text2"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="@color/kn_chip" />
</LinearLayout>