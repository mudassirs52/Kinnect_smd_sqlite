<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <RelativeLayout
        android:id="@+id/commentsHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvCommentsBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="‹   Comments"
            android:textColor="@color/kn_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/kn_pill_gray"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Most relevant ⌄"
            android:textColor="@color/kn_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <View
        android:id="@+id/divHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/commentsHeader"
        android:background="@color/kn_border" />

    <TextView
        android:id="@+id/tvPostReactions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/divHeader"
        android:padding="12dp"
        android:textColor="@color/kn_text"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvComments"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomReplyBar"
        android:layout_below="@id/tvPostReactions" />

    <TextView
        android:id="@+id/tvNoComments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvPostReactions"
        android:gravity="center"
        android:paddingTop="40dp"
        android:text="No comments yet. Be the first!"
        android:textColor="@color/kn_text2"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/bottomReplyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/kn_border" />

        <!-- Replying to / Cancel -->
        <RelativeLayout
            android:id="@+id/replyingBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvReplyingTo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/kn_text2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCancelReply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:padding="2dp"
                android:text="Cancel"
                android:textColor="@color/kn_text2"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Picked image preview -->
        <LinearLayout
            android:id="@+id/pendingImageRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivPending"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/btnRemovePending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="✕"
                android:textColor="@color/kn_text2"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="10dp"
            android:paddingTop="6dp">

            <ImageView
                android:id="@+id/btnPickImage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_camera"
                app:tint="@color/kn_teal" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@drawable/kn_pill_gray"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="12dp">

                <EditText
                    android:id="@+id/etComment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Write a reply..."
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="3"
                    android:textColorHint="@color/kn_text2"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_emoji_smile"
                    app:tint="@color/kn_text2" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnSend"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/kn_circle"
                android:backgroundTint="@color/kn_teal"
                android:contentDescription="@null"
                android:padding="12dp"
                android:src="@drawable/ic_send"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>