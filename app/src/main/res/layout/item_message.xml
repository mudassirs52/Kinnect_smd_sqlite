<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/msgRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="2dp">

    <TextView
        android:id="@+id/tvReplyLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/kn_text2"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvQuote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/kn_bubble_in"
        android:ellipsize="end"
        android:maxLines="2"
        android:maxWidth="240dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/kn_text2"
        android:textSize="12sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivMsgImage"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:maxHeight="300dp"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/kn_bubble_in"
        android:maxWidth="280dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:textColor="@color/kn_text"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/rowMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivHeart"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/kn_circle"
            android:backgroundTint="@color/white"
            android:contentDescription="@null"
            android:elevation="2dp"
            android:padding="4dp"
            android:src="@drawable/ic_heart"
            android:visibility="gone"
            app:tint="@color/kn_love" />

        <TextView
            android:id="@+id/tvEdited"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Edited"
            android:textColor="@color/kn_text2"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>