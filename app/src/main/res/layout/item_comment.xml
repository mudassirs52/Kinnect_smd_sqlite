<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="5dp">

    <TextView
        android:id="@+id/cAvatar"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/kn_circle"
        android:backgroundTint="@color/kn_maroon"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/cBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/kn_bubble_in"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/cName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/kn_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/kn_text"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/cImage"
            android:layout_width="180dp"
            android:layout_height="110dp"
            android:layout_marginTop="4dp"
            android:background="#E6E6E6"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/kn_text2"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Like"
                android:textColor="@color/kn_text2"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cReply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Reply"
                android:textColor="@color/kn_text2"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cLikes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="@color/kn_text2"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>