<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="66dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tvAvatar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/kn_circle"
        android:backgroundTint="@color/kn_green"
        android:gravity="center"
        android:text="OF"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textColor="@color/kn_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/kn_text2"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnAdd"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/kn_circle"
        android:backgroundTint="#E0EDED"
        android:contentDescription="Add friend"
        android:padding="11dp"
        android:src="@drawable/ic_person_add"
        app:tint="@color/kn_teal" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/kn_pill_gray"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="Requested"
        android:textColor="@color/kn_text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>